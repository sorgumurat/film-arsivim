<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Film & Dizi Arşivi</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background: #0a0a0a; font-family: system-ui, -apple-system, sans-serif; color: #fff; }
        
        /* Header */
        .header { background: #141414; padding: 20px; text-align: center; border-bottom: 1px solid #333; }
        .header h1 { font-size: 1.8rem; background: linear-gradient(135deg, #e50914, #ff6b6b); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .subtitle { font-size: 0.8rem; color: #888; margin-top: 5px; }
        
        /* Arama */
        .search-area { max-width: 600px; margin: 30px auto; padding: 0 20px; }
        .search-box { display: flex; gap: 10px; background: #2a2a2a; border-radius: 40px; padding: 5px; }
        .search-box input { flex: 1; background: transparent; border: none; padding: 14px 20px; color: white; font-size: 1rem; outline: none; }
        .search-box button { background: #e50914; border: none; padding: 0 25px; border-radius: 40px; color: white; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        .search-box button:hover { background: #f40612; }
        
        /* Sekmeler */
        .tabs { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px; margin: 20px auto 0; padding: 0 20px; }
        .tab-btn { background: transparent; border: none; padding: 10px 25px; font-size: 1rem; font-weight: 600; color: #888; cursor: pointer; border-radius: 30px; transition: all 0.2s; }
        .tab-btn.active { background: #e50914; color: white; }
        .tab-btn:not(.active):hover { color: white; background: #333; }
        
        /* Sonuçlar */
        .results-info { max-width: 1200px; margin: 20px auto 10px; padding: 0 20px; color: #888; font-size: 0.9rem; border-bottom: 1px solid #333; padding-bottom: 10px; }
        .movie-grid { max-width: 1200px; margin: 0 auto; padding: 0 20px 40px; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 20px; }
        .movie-card { background: #1a1a1a; border-radius: 10px; overflow: hidden; cursor: pointer; transition: transform 0.2s, background 0.2s; }
        .movie-card:hover { transform: translateY(-5px); background: #2a2a2a; }
        .movie-poster { aspect-ratio: 2/3; background: #2a2a2a; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
        .movie-poster img { width: 100%; height: 100%; object-fit: cover; }
        .movie-info { padding: 12px; }
        .movie-title { font-weight: 600; font-size: 0.9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-bottom: 4px; }
        .movie-year { font-size: 0.7rem; color: #888; }
        .badge { display: inline-block; font-size: 0.6rem; background: #333; padding: 2px 8px; border-radius: 20px; margin-top: 6px; }
        .badge.movie { background: #2a6b9e; }
        .badge.tv { background: #9e2a2a; }
        .badge.m3u { background: #2a9e5e; }
        
        .status { text-align: center; padding: 60px; color: #666; }
        
        /* M3U Panel */
        .m3u-panel { display: none; max-width: 1200px; margin: 0 auto; padding: 20px; }
        .m3u-upload-area { text-align: center; margin: 20px 0; padding: 30px; background: #1a1a1a; border-radius: 16px; border: 2px dashed #444; }
        .m3u-url-area { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
        .m3u-url-area input { flex: 1; background: #2a2a2a; border: none; padding: 12px 20px; color: white; font-size: 1rem; border-radius: 40px; outline: none; }
        .m3u-btn { background: #2a6b9e; border: none; padding: 12px 24px; border-radius: 40px; color: white; font-weight: bold; cursor: pointer; transition: background 0.2s; }
        .m3u-btn:hover { background: #1e4f73; }
        .m3u-clear-btn { background: #444; }
        .m3u-clear-btn:hover { background: #666; }
        .m3u-info { font-size: 0.8rem; color: #888; margin-top: 15px; }
        
        /* Bölüm Seçici Modal */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 1000; justify-content: center; align-items: center; }
        .modal.active { display: flex; }
        .modal-content { background: #1a1a1a; border-radius: 12px; max-width: 500px; width: 90%; max-height: 80vh; overflow-y: auto; padding: 20px; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid #333; padding-bottom: 10px; }
        .modal-header h3 { font-size: 1.2rem; }
        .modal-close { background: none; border: none; color: white; font-size: 24px; cursor: pointer; }
        .season-select, .episode-select { margin-bottom: 20px; }
        .season-select select, .episode-select select { width: 100%; padding: 12px; background: #2a2a2a; color: white; border: none; border-radius: 8px; font-size: 1rem; }
        .watch-btn { width: 100%; padding: 12px; background: #e50914; border: none; border-radius: 8px; color: white; font-weight: bold; cursor: pointer; font-size: 1rem; margin-top: 10px; }
        .watch-btn:hover { background: #f40612; }
        
        @media (max-width: 600px) {
            .movie-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 15px; }
            .tab-btn { padding: 6px 15px; font-size: 0.9rem; }
        }
    </style>
</head>
<body>

<div class="header">
    <h1>🎬 Film & Dizi Arşivi</h1>
    <div class="subtitle">TMDB + M3U | Altyazı & Dual Ses Desteği</div>
</div>

<div class="search-area">
    <div class="search-box">
        <input type="text" id="searchInput" placeholder="Film veya dizi ara... (örn: Avatar, The Last of Us)" autofocus>
        <button onclick="searchAll()">🔍 Ara</button>
    </div>
</div>

<!-- Sekmeler -->
<div class="tabs">
    <button class="tab-btn active" data-tab="all">🎬 Tümü</button>
    <button class="tab-btn" data-tab="movie">🎥 Filmler</button>
    <button class="tab-btn" data-tab="tv">📺 Diziler</button>
    <button class="tab-btn" data-tab="m3u">📁 M3U Listem</button>
</div>

<div id="resultsInfo" class="results-info" style="display: none;"><span id="resultCount">0</span> sonuç bulundu</div>
<div id="movieGrid" class="movie-grid"><div class="status">🔍 Arama yapmak için yukarıya bir isim yazın</div></div>

<!-- M3U Paneli -->
<div id="m3uPanel" class="m3u-panel">
    <div class="m3u-upload-area">
        <h3 style="margin-bottom: 15px;">📁 M3U Listesi Yükle</h3>
        <input type="file" id="m3uFileInput" accept=".m3u,.txt" style="display: none;">
        <button id="uploadM3uBtn" class="m3u-btn">📂 Dosya Seç</button>
        <p class="m3u-info">.m3u veya .txt formatında M3U listenizi yükleyin. Liste sadece sizin tarayıcınızda saklanır.</p>
    </div>
    <div class="m3u-upload-area">
        <h3 style="margin-bottom: 15px;">🔗 M3U Linki ile Yükle</h3>
        <div class="m3u-url-area">
            <input type="text" id="m3uUrlInput" placeholder="https://example.com/liste.m3u">
            <button id="loadM3uUrlBtn" class="m3u-btn">🌐 Yükle</button>
        </div>
        <p class="m3u-info">Çevrimiçi bir M3U dosyasının URL'sini yapıştırın.</p>
    </div>
    <div style="text-align: right; margin-bottom: 20px;">
        <button id="clearM3uBtn" class="m3u-btn m3u-clear-btn">🗑️ Listeyi Temizle</button>
    </div>
    <div id="m3uMovieGrid" class="movie-grid"></div>
</div>

<!-- Bölüm Seçici Modal -->
<div id="episodeModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modalTitle">Dizi Adı</h3>
            <button class="modal-close" onclick="closeModal()">✕</button>
        </div>
        <div class="season-select">
            <label>Sezon:</label>
            <select id="seasonSelect"></select>
        </div>
        <div class="episode-select">
            <label>Bölüm:</label>
            <select id="episodeSelect"></select>
        </div>
        <button class="watch-btn" onclick="watchEpisode()">▶ İzle</button>
    </div>
</div>

<script>
    const TMDB_API_KEY = 'e482e6dc4fe81df89c51267e9e14cf96';
    const EMBED_URL_MOVIE = 'https://vidsrc.to/embed/movie/';
    const EMBED_URL_TV = 'https://vidsrc.to/embed/tv/';
    
    let currentResults = [];
    let currentTab = 'all';
    let selectedTvId = null;
    let selectedTvTitle = '';
    let selectedSeason = 1;
    let selectedEpisode = 1;
    let totalSeasons = 0;
    
    // M3U Değişkenleri
    let m3uMovies = [];

    // Sekme değiştirme
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentTab = btn.dataset.tab;
            
            if (currentTab === 'm3u') {
                document.getElementById('movieGrid').style.display = 'none';
                document.getElementById('resultsInfo').style.display = 'none';
                document.getElementById('m3uPanel').style.display = 'block';
                loadM3UFromLocalStorage();
            } else {
                document.getElementById('movieGrid').style.display = 'grid';
                document.getElementById('m3uPanel').style.display = 'none';
                document.getElementById('resultsInfo').style.display = currentResults.length ? 'block' : 'none';
                displayResults(currentResults);
            }
        });
    });

    // TMDB Arama (Film + Dizi)
    async function searchAll() {
        const query = document.getElementById('searchInput').value.trim();
        if (query.length < 2) return;

        document.getElementById('movieGrid').innerHTML = '<div class="status">⏳ Aranıyor...</div>';
        document.getElementById('resultsInfo').style.display = 'none';

        try {
            const [movieRes, tvRes] = await Promise.all([
                fetch(`https://api.themoviedb.org/3/search/movie?api_key=${TMDB_API_KEY}&query=${encodeURIComponent(query)}&language=tr-TR`),
                fetch(`https://api.themoviedb.org/3/search/tv?api_key=${TMDB_API_KEY}&query=${encodeURIComponent(query)}&language=tr-TR`)
            ]);
            
            const movies = (await movieRes.json()).results || [];
            const tvShows = (await tvRes.json()).results || [];
            
            currentResults = [
                ...movies.map(m => ({ ...m, media_type: 'movie' })),
                ...tvShows.map(t => ({ ...t, media_type: 'tv' }))
            ];
            
            currentResults.sort((a, b) => {
                const dateA = a.release_date || a.first_air_date || '';
                const dateB = b.release_date || b.first_air_date || '';
                return dateB.localeCompare(dateA);
            });
            
            document.getElementById('resultCount').innerText = currentResults.length;
            document.getElementById('resultsInfo').style.display = 'block';
            
            if (currentResults.length === 0) {
                document.getElementById('movieGrid').innerHTML = '<div class="status">🎬 Film veya dizi bulunamadı.</div>';
                return;
            }
            
            displayResults(currentResults);
            
        } catch(e) {
            console.error(e);
            document.getElementById('movieGrid').innerHTML = '<div class="status">❌ Hata oluştu. Lütfen tekrar deneyin.</div>';
        }
    }

    function displayResults(results) {
        let filteredResults = results;
        
        if (currentTab === 'movie') {
            filteredResults = results.filter(r => r.media_type === 'movie');
        } else if (currentTab === 'tv') {
            filteredResults = results.filter(r => r.media_type === 'tv');
        }
        
        if (filteredResults.length === 0) {
            document.getElementById('movieGrid').innerHTML = '<div class="status">📭 Bu kategoride sonuç bulunamadı.</div>';
            document.getElementById('resultCount').innerText = filteredResults.length;
            return;
        }
        
        document.getElementById('resultCount').innerText = filteredResults.length;
        
        document.getElementById('movieGrid').innerHTML = filteredResults.map(item => {
            const title = item.title || item.name;
            const year = item.release_date ? item.release_date.substring(0,4) : (item.first_air_date ? item.first_air_date.substring(0,4) : '?');
            const posterPath = item.poster_path;
            const mediaType = item.media_type;
            const isMovie = mediaType === 'movie';
            const badgeClass = isMovie ? 'movie' : 'tv';
            const badgeIcon = isMovie ? '🎬' : '📺';
            const badgeText = isMovie ? 'Film' : 'Dizi';
            
            return `
                <div class="movie-card" onclick="${isMovie ? `window.open('${EMBED_URL_MOVIE}${item.id}', '_blank')` : `openTvModal(${item.id}, '${title.replace(/'/g, "\\'")}')`}">
                    <div class="movie-poster">
                        ${posterPath ? `<img src="https://image.tmdb.org/t/p/w200${posterPath}" alt="${title}">` : (isMovie ? '🎬' : '📺')}
                    </div>
                    <div class="movie-info">
                        <div class="movie-title">${title}</div>
                        <div class="movie-year">${year}</div>
                        <span class="badge ${badgeClass}">${badgeIcon} ${badgeText}</span>
                    </div>
                </div>
            `;
        }).join('');
    }

    // Dizi Modal İşlemleri
    async function openTvModal(tvId, title) {
        selectedTvId = tvId;
        selectedTvTitle = title;
        
        try {
            const response = await fetch(`https://api.themoviedb.org/3/tv/${tvId}?api_key=${TMDB_API_KEY}&language=tr-TR`);
            const data = await response.json();
            totalSeasons = data.number_of_seasons || 1;
            
            const seasonSelect = document.getElementById('seasonSelect');
            seasonSelect.innerHTML = '';
            for (let i = 1; i <= totalSeasons; i++) {
                const option = document.createElement('option');
                option.value = i;
                option.textContent = `${i}. Sezon`;
                seasonSelect.appendChild(option);
            }
            
            selectedSeason = 1;
            updateEpisodeSelect();
            
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('episodeModal').classList.add('active');
            
        } catch(e) {
            console.error(e);
            alert('Dizi bilgileri alınamadı.');
        }
    }
    
    function updateEpisodeSelect() {
        const episodeSelect = document.getElementById('episodeSelect');
        episodeSelect.innerHTML = '';
        for (let i = 1; i <= 20; i++) {
            const option = document.createElement('option');
            option.value = i;
            option.textContent = `${i}. Bölüm`;
            episodeSelect.appendChild(option);
        }
    }
    
    document.getElementById('seasonSelect').addEventListener('change', (e) => {
        selectedSeason = parseInt(e.target.value);
        updateEpisodeSelect();
    });
    
    document.getElementById('episodeSelect').addEventListener('change', (e) => {
        selectedEpisode = parseInt(e.target.value);
    });
    
    function watchEpisode() {
        const url = `${EMBED_URL_TV}${selectedTvId}/${selectedSeason}/${selectedEpisode}`;
        window.open(url, '_blank');
        closeModal();
    }
    
    function closeModal() {
        document.getElementById('episodeModal').classList.remove('active');
    }
    
    // M3U İşlemleri
    function parseM3U(content) {
        const lines = content.split('\n');
        const movies = [];
        let currentTitle = '';
        
        for (let i = 0; i < lines.length; i++) {
            let line = lines[i].trim();
            if (line.startsWith('#EXTINF:')) {
                const titleMatch = line.match(/,([^,]+)$/);
                currentTitle = titleMatch ? titleMatch[1].trim() : 'Bilinmeyen';
                if (currentTitle.startsWith('TR:')) currentTitle = currentTitle.substring(3);
            } else if (line && !line.startsWith('#') && currentTitle) {
                let url = line;
                let poster = '';
                let type = 'direct';
                
                if (url.includes('vidmody')) type = 'vidmody';
                else if (url.includes('.m3u8')) type = 'm3u8';
                
                movies.push({ title: currentTitle, url, poster, type });
                currentTitle = '';
            }
        }
        
        m3uMovies = movies;
        displayM3UMovies(m3uMovies);
        saveM3UToLocalStorage(m3uMovies);
    }
    
    function displayM3UMovies(movies) {
        const grid = document.getElementById('m3uMovieGrid');
        if (!movies.length) {
            grid.innerHTML = '<div class="status">📭 M3U listesinde film bulunamadı. Yukarıdan bir dosya yükleyin veya URL girin.</div>';
            return;
        }
        
        grid.innerHTML = movies.map((movie, index) => `
            <div class="movie-card" onclick="playM3UMovie('${movie.url.replace(/'/g, "\\'")}', '${movie.title.replace(/'/g, "\\'")}')">
                <div class="movie-poster">
                    ${movie.poster ? `<img src="${movie.poster}" onerror="this.parentElement.innerHTML='🎬'">` : '🎬'}
                </div>
                <div class="movie-info">
                    <div class="movie-title">${movie.title}</div>
                    <span class="badge m3u">📁 M3U</span>
                </div>
            </div>
        `).join('');
    }
    
    function playM3UMovie(url, title) {
        if (confirm(`"${title}" oynatılsın mı?`)) {
            window.open(url, '_blank');
        }
    }
    
    function saveM3UToLocalStorage(movies) {
        localStorage.setItem('m3u_movies', JSON.stringify(movies));
    }
    
    function loadM3UFromLocalStorage() {
        const saved = localStorage.getItem('m3u_movies');
        if (saved) {
            try {
                m3uMovies = JSON.parse(saved);
                if (m3uMovies.length) displayM3UMovies(m3uMovies);
                else displayM3UMovies([]);
            } catch(e) {}
        } else {
            displayM3UMovies([]);
        }
    }
    
    function clearM3UList() {
        if (confirm('M3U listesini temizlemek istediğinize emin misiniz?')) {
            localStorage.removeItem('m3u_movies');
            m3uMovies = [];
            displayM3UMovies([]);
        }
    }
    
    // M3U Dosya Yükleme
    document.getElementById('uploadM3uBtn').addEventListener('click', () => {
        document.getElementById('m3uFileInput').click();
    });
    
    document.getElementById('m3uFileInput').addEventListener('change', async (event) => {
        const file = event.target.files[0];
        if (!file) return;
        
        const content = await file.text();
        parseM3U(content);
        alert(`${m3uMovies.length} film yüklendi!`);
    });
    
    // M3U URL ile Yükleme
    document.getElementById('loadM3uUrlBtn').addEventListener('click', async () => {
        const url = document.getElementById('m3uUrlInput').value.trim();
        if (!url) {
            alert('Lütfen geçerli bir URL girin.');
            return;
        }
        
        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Dosya bulunamadı');
            const content = await response.text();
            parseM3U(content);
            alert(`${m3uMovies.length} film yüklendi!`);
            document.getElementById('m3uUrlInput').value = '';
        } catch(e) {
            alert('M3U dosyası yüklenemedi. URL\'yi kontrol edin.');
        }
    });
    
    // M3U Listeyi Temizle
    document.getElementById('clearM3uBtn').addEventListener('click', clearM3UList);
    
    // Sayfa yüklendiğinde kayıtlı M3U listesini yükle
    loadM3UFromLocalStorage();
    
    // Enter tuşu ile arama
    document.getElementById('searchInput').addEventListener('keypress', e => { if (e.key === 'Enter') searchAll(); });
    
    // Modal dışına tıklayınca kapat
    document.getElementById('episodeModal').addEventListener('click', (e) => {
        if (e.target === document.getElementById('episodeModal')) closeModal();
    });
</script>
</body>
</html>
